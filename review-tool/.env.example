# --- Database (Neon, pooled connection) ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require&channel_binding=require"

# --- Neon Auth (Neon Console -> Auth tab -> Configuration) ---
NEON_AUTH_BASE_URL="https://<endpoint>.neonauth.<region>.aws.neon.tech/neondb/auth"
# generate with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=""


# --- Hexclave (app.hexclave.com -> project -> API keys) ---
NEXT_PUBLIC_HEXCLAVE_PROJECT_ID=""
NEXT_PUBLIC_HEXCLAVE_PUBLISHABLE_CLIENT_KEY=""
HEXCLAVE_SECRET_SERVER_KEY=""
